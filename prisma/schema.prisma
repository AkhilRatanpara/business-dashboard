datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  sourcePage Int?      @map("source_page")
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("SubCategories")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     Item[]

  @@unique([parentId, name])
  @@map("categories")
}

model Item {
  id            String         @id @default(cuid())
  name          String
  itemCode      String?        @map("item_code")
  categoryId    String         @map("category_id")
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  srNo          String?        @map("sr_no")
  brand         String?
  modelNumber   String?        @map("model_number")
  costPrice     Decimal        @map("cost_price") @db.Decimal(12, 2)
  retailerPrice Decimal        @map("retailer_price") @db.Decimal(12, 2)
  customerPrice Decimal        @map("customer_price") @db.Decimal(12, 2)
  unit          String?        @default("pcs")
  notes         String?
  catalogGroup  String?        @map("catalog_group")
  catalogSrNo   Int?           @map("catalog_sr_no")
  variantSrNo   Int?           @map("variant_sr_no")
  sortOrder     Int            @default(0) @map("sort_order")
  sourcePage    Int?           @map("source_page")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  priceHistories PriceHistory[]

  @@index([name])
  @@index([itemCode])
  @@index([brand])
  @@index([srNo])
  @@index([categoryId])
  @@index([updatedAt])
  @@index([catalogGroup])
  @@index([categoryId, sortOrder])
  @@map("items")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brands")
}

model PriceHistory {
  id               String   @id @default(cuid())
  itemId           String   @map("item_id")
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  oldCostPrice     Decimal  @map("old_cost_price") @db.Decimal(12, 2)
  newCostPrice     Decimal  @map("new_cost_price") @db.Decimal(12, 2)
  oldRetailerPrice Decimal  @map("old_retailer_price") @db.Decimal(12, 2)
  newRetailerPrice Decimal  @map("new_retailer_price") @db.Decimal(12, 2)
  oldCustomerPrice Decimal  @map("old_customer_price") @db.Decimal(12, 2)
  newCustomerPrice Decimal  @map("new_customer_price") @db.Decimal(12, 2)
  changeNote       String?  @map("change_note")
  changedAt        DateTime @default(now()) @map("changed_at")

  @@index([itemId])
  @@index([changedAt])
  @@map("price_history")
}

model SystemSettings {
  id             String   @id @default("settings")
  pinHash        String   @map("pin_hash")
  viewerPinHash  String?  @map("viewer_pin_hash")
  themeMode      String   @default("dark") @map("theme_mode")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id          String   @id @default(cuid())
  actionType  String   // "CREATE", "UPDATE", "DELETE"
  entityType  String   // "ITEM", "CATEGORY"
  entityId    String
  entityName  String
  oldData     Json?
  newData     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

